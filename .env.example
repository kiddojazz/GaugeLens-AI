# GaugeLens settings. Copy to .env and fill in. Never commit .env.

# --- Meta Model API: Muse Spark reads displays and runs the agent; SAM 3.1 finds the displays
#   muse-spark-1.3 = Standard mode (content NOT used for training). Use Standard for real footage.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_READ=muse-spark-1.3
# structured output: json_schema (response_format, schema-constrained) | tool (one tool call).
# Meta's Chat Completions accepts tool_choice=auto only.
LLM_STRUCTURED_MODE=json_schema
LLM_TOOL_CHOICE=auto
# optional: image detail hint, reasoning effort and temperature (empty = not sent)
LLM_IMAGE_DETAIL=
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=
# display discovery: meta = SAM 3.1 finds the displays in each clip (falls back to registered regions);
#                    manual = registered regions only (no SAM calls)
SEG_PROVIDER=meta

# --- Cache: every model response is cached by hash(model, prompt version, input).
# CACHE_ONLY=true never calls a model (judges / CI / offline demo).
CACHE_ONLY=false

# --- Database (docker compose service "db")
POSTGRES_PASSWORD=change-me
# Host port 5433 (5432 is often taken by a native PostgreSQL). Use 127.0.0.1, not localhost: on Windows
# "localhost" tries IPv6 first and adds ~2 s to every connection.
DATABASE_URL=postgresql://gaugelens:change-me@127.0.0.1:5433/gaugelens
# the hosted Postgres used by the Azure deployment (deploy/azure.py); copy data with backend.app.db.copy
AZURE_DATABASE_URL=

# --- Evidence files (videos, frames, crops): local | blob (Azure Blob Storage, local folder as a cache)
# Connection string: storage account -> Security + networking -> Access keys -> Connection string.
# Copy existing local files up with: python -m backend.app.cli evidence-sync
EVIDENCE_STORE=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=guagelens

# --- Messenger (Meta Messenger Platform): your app -> Messenger -> Messenger API Settings
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
# shared by the webhooks: any long random string (entered in Meta's webhook form), the app secret
# (App settings -> Basic), and the equipment a clip sent by message is filed under
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
CHANNEL_DEFAULT_EQUIPMENT=inv_mock
META_GRAPH_VERSION=v25.0
